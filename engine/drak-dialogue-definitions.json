  "intro": {
    "optionGuid": "8d0b76f6-7a2a-5dec-8abe-f68719712c7c",
    "body": {
      "key": "intro",
      "guid": "a79fd353-ef2e-5b2d-86b7-163d3b0f57dd",
      "de": "Ssarikk. Handwerker, Wanderer – und aus freiem Willen hier. Dein Rufzeichen hat mich gefunden. Was möchtest du wissen?",
      "en": "Ssarikk. Craftsman, wanderer—and here by my own choice. Your calling mark has found me. What would you like to know?"
    }
  },
  "farewell": {
    "optionGuid": "a5734573-a621-55fb-8f5d-f9589cb3d699",
    "body": {
      "key": "farewell",
      "guid": "88683cd9-f264-5a87-b534-a49a05ea1dcc",
      "de": "Bewahre das Rufzeichen. Ich kehre zurück, solange unser Pakt besteht.",
      "en": "Keep the calling mark safe. I will return while our pact holds."
    }
  },
  "topics": [
    {
      "key": "identity",
      "optionGuid": "11dbc7d0-7db9-5d29-b038-2d67754c5231",
      "label": {
        "key": "identity.label",
        "guid": "633172a6-1e9a-51d2-92af-3c1d158883b1",
        "de": "Wer bist du?",
        "en": "Who are you?"
      },
      "body": {
        "key": "identity.body",
        "guid": "0e7da0f9-4931-5e5d-a17d-4935a25acdde",
        "de": "Ich bin Ssarikk. Als ich meine Heimat verlassen musste, nahm ich meine Werkzeuge mit, nicht den Streit meiner Leute. Unter dem Schutz deiner Flamme kann ich wieder arbeiten. Du erhältst mein Handwerk, ich einen sicheren Ort.",
        "en": "I am Ssarikk. When I had to leave my home, I took my tools, not my people’s quarrels. Under the protection of your Flame, I can work again. You gain my craft; I gain a safe place."
      },
      "uiHintType": "None"
    },
    {
      "key": "summoning",
      "optionGuid": "6721697f-cf43-5171-ac52-0870cd99b31a",
      "label": {
        "key": "summoning.label",
        "guid": "731a18ab-aaeb-57cb-8c70-5a9eef8cbdda",
        "de": "Warum kann ich dich rufen?",
        "en": "Why can I summon you?"
      },
      "body": {
        "key": "summoning.body",
        "guid": "84422314-7242-5082-8824-d0700787e55d",
        "de": "Weil ich es erlaubt habe. Dein Beschwörungsstab trägt mein Rufzeichen. Ein geschützter Flammenaltar weist mir den Weg zu dir. Ich bin kein wiedererwecktes Skelett und kein gefesselter Geist. Dies ist ein freiwilliger Pakt.",
        "en": "Because I agreed to it. Your Summoning Staff carries my calling mark. A safe Flame Altar shows me the way to you. I am no reanimated skeleton and no captive spirit. This is a willing pact."
      },
      "uiHintType": "Hint"
    },
    {
      "key": "companions",
      "optionGuid": "24d8863a-1ea1-5191-ab9a-00665d9a223e",
      "label": {
        "key": "companions.label",
        "guid": "f36990ad-3bc3-58e1-9ac5-b757894542c1",
        "de": "Wer sind deine Gefährten?",
        "en": "Who are your companions?"
      },
      "body": {
        "key": "companions.body",
        "guid": "9f746838-3165-570b-945d-7ced6c095087",
        "de": "Meine Gefährten haben denselben Pakt gewählt. Der Speer hält die Front, das Chakram schützt die Flanken, der Magier trägt das geheime Wort. Du rufst ihre Hilfe, nicht ihren Willen. Behandle sie wie Verbündete.",
        "en": "My companions chose the same pact. The spear holds the front, the chakram guards the flanks, and the mage bears the hidden word. You call for their help, not control of their will. Treat them as allies."
      },
      "uiHintType": "None"
    },
    {
      "key": "craft",
      "optionGuid": "6d759b57-0453-5a63-afcb-01fc6d8cb1ef",
      "label": {
        "key": "craft.label",
        "guid": "2cb0daeb-2456-5982-812c-fbd87c07dca6",
        "de": "Was stellst du her?",
        "en": "What do you craft?"
      },
      "body": {
        "key": "craft.body",
        "guid": "6d7cfa59-bcf6-5695-a35e-d3b30ed76c2c",
        "de": "Aus Drak-Schuppen, Klauen, Zähnen und Blut forme ich beständige Rufzauber; für den Magier brauche ich auch Aquamarin. Der Stab bringt mich zu dir. Meine Zauber rufen die Gefährten. Über mein Handwerksmenü kannst du sie herstellen.",
        "en": "From Drak scales, claws, teeth, and blood, I shape lasting calling spells; the mage also requires aquamarine. The staff brings me to you. My spells call the companions. You can craft them through my workshop menu."
      },
      "uiHintType": "None"
    }
  ],
